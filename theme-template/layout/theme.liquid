<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="h-full">
<head>
  <title>{{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0ea5e9">
  
  <!-- SEO Meta Tags -->
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  
  <!-- Preconnect to external domains -->
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Favicon -->
  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% endif %}
  
  <!-- Theme CSS & JS -->
  {{ 'style' | asset_url | stylesheet_tag }}
  
  <!-- Header hook for plugins -->
  {{ content_for_header }}
  
  <!-- Schema.org structured data -->
  {% render 'meta-tags' %}
</head>

<body class="min-h-full bg-gray-50" x-data="{ cartOpen: false, searchOpen: false, mobileMenuOpen: false }">
  <!-- Skip to content link -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-primary-600 text-white px-4 py-2 rounded-lg z-50">
    Skip to content
  </a>

  <!-- Header -->
  <header class="bg-white shadow-sm sticky top-0 z-40" x-data="navigation()">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16 lg:h-20">
        
        <!-- Mobile menu button -->
        <button @click="toggle()" class="lg:hidden p-2 text-gray-600 hover:text-primary-600 transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" x-show="!open"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" x-show="open"></path>
          </svg>
        </button>

        <!-- Logo -->
        <div class="flex-shrink-0">
          <a href="{{ routes.root_url }}" class="text-2xl font-heading font-bold text-gray-900 hover:text-primary-600 transition-colors">
            {% if settings.logo != blank %}
              <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" class="h-8 lg:h-10 w-auto">
            {% else %}
              {{ shop.name }}
            {% endif %}
          </a>
        </div>

        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex space-x-8">
          {% for link in linklists.main-menu.links %}
            {% assign child_list_handle = link.title | handleize %}
            {% if linklists[child_list_handle].links != blank %}
              <div class="relative group">
                <a href="{{ link.url }}" class="text-gray-700 hover:text-primary-600 px-3 py-2 text-sm font-medium transition-colors flex items-center">
                  {{ link.title }}
                  <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </a>
                <div class="absolute left-0 mt-2 w-48 bg-white rounded-xl shadow-premium opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                  <div class="py-2">
                    {% for childlink in linklists[child_list_handle].links %}
                      <a href="{{ childlink.url }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-primary-600 transition-colors">
                        {{ childlink.title | escape }}
                      </a>
                    {% endfor %}
                  </div>
                </div>
              </div>
            {% else %}
              <a href="{{ link.url }}" class="text-gray-700 hover:text-primary-600 px-3 py-2 text-sm font-medium transition-colors">
                {{ link.title }}
              </a>
            {% endif %}
          {% endfor %}
        </nav>

        <!-- Header Actions -->
        <div class="flex items-center space-x-4">
          <!-- Search -->
          <button @click="searchOpen = true" class="text-gray-600 hover:text-primary-600 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </button>

          <!-- Account -->
          {% if shop.customer_accounts_enabled %}
            <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="text-gray-600 hover:text-primary-600 transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            </a>
          {% endif %}

          <!-- Cart -->
          <button @click="cartOpen = true" class="relative text-gray-600 hover:text-primary-600 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.293 2.293a1 1 0 001.414 1.414L10 13m0 0v6a2 2 0 002 2h2a2 2 0 002-2v-6"></path>
            </svg>
            {% if cart.item_count > 0 %}
              <span class="absolute -top-2 -right-2 bg-primary-600 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center">
                {{ cart.item_count }}
              </span>
            {% endif %}
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div x-show="open" x-transition class="lg:hidden bg-white border-t border-gray-200">
      <div class="px-4 py-6 space-y-4">
        {% for link in linklists.main-menu.links %}
          <a href="{{ link.url }}" class="block text-gray-700 hover:text-primary-600 font-medium transition-colors">
            {{ link.title }}
          </a>
        {% endfor %}
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main id="main-content" role="main" class="flex-1">
    {{ content_for_layout }}
  </main>

  <!-- Footer -->
  <footer class="bg-gray-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <!-- Company Info -->
        <div class="space-y-4">
          <h3 class="text-lg font-heading font-semibold">{{ shop.name }}</h3>
          <p class="text-gray-300 text-sm">
            {{ shop.description | default: "Premium quality products for modern lifestyle." | truncate: 120 }}
          </p>
          {% if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_twitter_link != blank %}
            <div class="flex space-x-4">
              {% if settings.social_facebook_link != blank %}
                <a href="{{ settings.social_facebook_link }}" class="text-gray-400 hover:text-white transition-colors">
                  <span class="sr-only">Facebook</span>
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M20 10C20 4.477 15.523 0 10 0S0 4.477 0 10c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V10h2.54V7.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V10h2.773l-.443 2.89h-2.33v6.988C16.343 19.128 20 14.991 20 10z" clip-rule="evenodd"></path>
                  </svg>
                </a>
              {% endif %}
              {% if settings.social_instagram_link != blank %}
                <a href="{{ settings.social_instagram_link }}" class="text-gray-400 hover:text-white transition-colors">
                  <span class="sr-only">Instagram</span>
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.477 0 10s4.477 10 10 10 10-4.477 10-10S15.523 0 10 0zm0 18c-4.411 0-8-3.589-8-8s3.589-8 8-8 8 3.589 8 8-3.589 8-8 8z" clip-rule="evenodd"></path>
                  </svg>
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>

        <!-- Quick Links -->
        <div class="space-y-4">
          <h3 class="text-lg font-heading font-semibold">Quick Links</h3>
          <ul class="space-y-2 text-sm">
            {% for link in linklists.footer.links %}
              <li>
                <a href="{{ link.url }}" class="text-gray-300 hover:text-white transition-colors">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>

        <!-- Customer Service -->
        <div class="space-y-4">
          <h3 class="text-lg font-heading font-semibold">Customer Service</h3>
          <ul class="space-y-2 text-sm text-gray-300">
            <li><a href="{{ routes.search_url }}" class="hover:text-white transition-colors">Search</a></li>
            {% if shop.customer_accounts_enabled %}
              <li><a href="{{ routes.account_url }}" class="hover:text-white transition-colors">My Account</a></li>
            {% endif %}
            <li><a href="{{ routes.cart_url }}" class="hover:text-white transition-colors">Cart</a></li>
          </ul>
        </div>

        <!-- Newsletter -->
        <div class="space-y-4">
          <h3 class="text-lg font-heading font-semibold">Stay Updated</h3>
          <p class="text-gray-300 text-sm">Subscribe to get special offers and updates.</p>
          <form action="#" method="post" class="space-y-2">
            <input type="email" placeholder="Your email" class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-400 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-colors">
            <button type="submit" class="w-full btn-primary text-sm">Subscribe</button>
          </form>
        </div>
      </div>

      <div class="border-t border-gray-800 mt-8 pt-8 text-center text-sm text-gray-400">
        <p>&copy; {{ "now" | date: "%Y" }} {{ shop.name }}. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <!-- Cart Drawer -->
  {% render 'cart-drawer' %}

  <!-- Search Modal -->
  {% render 'search-modal' %}

  <!-- Theme JavaScript -->
  {{ 'application.js' | asset_url | script_tag }}
  
  <!-- Shopify's required checkout scripts -->
  {% render 'cart-scripts' %}
</body>
</html>
