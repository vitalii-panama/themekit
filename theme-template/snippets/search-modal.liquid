<!-- Search Modal -->
<div x-show="searchOpen" x-transition.opacity class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
    <!-- Background overlay -->
    <div x-show="searchOpen" x-transition.opacity class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" @click="searchOpen = false"></div>

    <!-- This element is to trick the browser into centering the modal contents. -->
    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

    <!-- Modal panel -->
    <div x-show="searchOpen" 
         x-transition:enter="transform transition ease-out duration-300" 
         x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" 
         x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" 
         x-transition:leave="transform transition ease-in duration-200" 
         x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" 
         x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
         class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
      
      <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
        <div class="sm:flex sm:items-start">
          <div class="w-full">
            <!-- Header -->
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
                Search Products
              </h3>
              <button @click="searchOpen = false" class="text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500 rounded-md">
                <span class="sr-only">Close</span>
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            <!-- Search Form -->
            <form action="{{ routes.search_url }}" method="get" role="search">
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
                <input type="search" 
                       name="q" 
                       placeholder="Search for products..." 
                       value="{{ search.terms | escape }}"
                       class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-primary-500 focus:border-primary-500 sm:text-sm"
                       x-data="{ query: '{{ search.terms | escape }}' }"
                       x-model="query"
                       @input.debounce.300ms="performSearch(query)"
                       autofocus>
              </div>
              
              <!-- Search Suggestions/Results -->
              <div class="mt-4 max-h-64 overflow-y-auto" id="search-results">
                {% if search.performed %}
                  {% if search.results.size > 0 %}
                    <div class="space-y-2">
                      {% for item in search.results limit: 6 %}
                        <a href="{{ item.url }}" class="flex items-center p-3 hover:bg-gray-50 rounded-lg transition-colors group">
                          {% if item.featured_image %}
                            <img src="{{ item.featured_image | image_url: width: 48 }}" alt="{{ item.title | escape }}" class="w-12 h-12 object-cover rounded-md mr-3">
                          {% else %}
                            <div class="w-12 h-12 bg-gray-100 rounded-md mr-3 flex items-center justify-center">
                              <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                              </svg>
                            </div>
                          {% endif %}
                          <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-900 group-hover:text-primary-600 transition-colors">
                              {{ item.title | truncate: 40 }}
                            </p>
                            {% if item.object_type == 'product' %}
                              <p class="text-sm text-gray-500">
                                {{ item.price | money }}
                                {% if item.compare_at_price > item.price %}
                                  <span class="line-through text-gray-400 ml-2">{{ item.compare_at_price | money }}</span>
                                {% endif %}
                              </p>
                            {% endif %}
                          </div>
                          <svg class="w-4 h-4 text-gray-400 group-hover:text-primary-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                          </svg>
                        </a>
                      {% endfor %}
                    </div>
                    
                    {% if search.results.size > 6 %}
                      <div class="mt-4 text-center">
                        <button type="submit" class="btn-secondary text-sm">
                          View all {{ search.results.size }} results
                        </button>
                      </div>
                    {% endif %}
                  {% else %}
                    <div class="text-center py-8">
                      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                      </svg>
                      <h3 class="mt-2 text-sm font-medium text-gray-900">No results found</h3>
                      <p class="mt-1 text-sm text-gray-500">Try adjusting your search to find what you're looking for.</p>
                    </div>
                  {% endif %}
                {% else %}
                  <!-- Popular searches or suggestions -->
                  <div class="space-y-2">
                    <h4 class="text-xs font-medium text-gray-500 uppercase tracking-wide">Popular searches</h4>
                    {% assign popular_searches = 'Dresses,Shoes,Accessories,Bags,Jewelry' | split: ',' %}
                    {% for search_term in popular_searches %}
                      <a href="{{ routes.search_url }}?q={{ search_term | url_param_escape }}" class="block text-sm text-gray-700 hover:text-primary-600 transition-colors py-1">
                        {{ search_term }}
                      </a>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function performSearch(query) {
  if (query.length < 2) {
    return;
  }
  
  // Implement real-time search here
  // This would typically make an AJAX request to search results
  fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=6`)
    .then(response => response.json())
    .then(data => {
      // Update search results
      console.log('Search results:', data);
    })
    .catch(error => {
      console.error('Search error:', error);
    });
}
</script>