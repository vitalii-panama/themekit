<!-- Hero Section -->
<section class="relative bg-gradient-to-br from-primary-50 to-secondary-50 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-r from-primary-600/10 to-secondary-600/10"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
    <div class="text-center">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-heading font-bold text-gray-900 mb-6 animate-fade-in">
        Premium
        <span class="text-primary-600">Collection</span>
      </h1>
      <p class="text-xl md:text-2xl text-gray-600 mb-8 max-w-3xl mx-auto animate-fade-in">
        Discover our curated selection of premium products designed for modern lifestyle
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in">
        <a href="{{ collections.all.url }}" class="btn-primary text-lg px-8 py-4">
          Shop Collection
        </a>
        <a href="#featured" class="btn-secondary text-lg px-8 py-4">
          Explore Features
        </a>
      </div>
    </div>
  </div>
  
  <!-- Floating Elements -->
  <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-primary-200 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-bounce-slow"></div>
  <div class="absolute top-1/3 right-1/4 w-72 h-72 bg-secondary-200 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-bounce-slow" style="animation-delay: 2s;"></div>
</section>

<!-- Featured Products -->
<section id="featured" class="py-16 lg:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-4">
        Featured Products
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Handpicked products that represent the best of our collection
      </p>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {% for product in collections.frontpage.products limit: 8 %}
        <div class="card group cursor-pointer animate-on-scroll" onclick="window.location.href='{{ product.url | within: collection }}'">
          <div class="aspect-w-1 aspect-h-1 w-full overflow-hidden bg-gray-100 rounded-t-2xl">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 400 }}" 
                   alt="{{ product.featured_image.alt | escape }}" 
                   class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500">
            {% else %}
              <div class="w-full h-64 bg-gray-200 flex items-center justify-center">
                <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
            {% endif %}
          </div>
          
          <div class="p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-primary-600 transition-colors">
              {{ product.title }}
            </h3>
            
            {% if product.vendor != blank %}
              <p class="text-sm text-gray-500 mb-2">{{ product.vendor }}</p>
            {% endif %}
            
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <span class="text-lg font-bold text-gray-900">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="text-sm text-gray-500 line-through">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
              
              {% unless product.available %}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                  Sold Out
                </span>
              {% else %}
                {% if product.compare_at_price > product.price %}
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    Sale
                  </span>
                {% endif %}
              {% endunless %}
            </div>
            
            <button class="mt-4 w-full btn-primary text-sm py-2" 
                    {% unless product.available %}disabled{% endunless %}>
              {% if product.available %}
                Add to Cart
              {% else %}
                Sold Out
              {% endif %}
            </button>
          </div>
        </div>
      {% endfor %}
    </div>
    
    <div class="text-center mt-12">
      <a href="{{ collections.all.url }}" class="btn-secondary">
        View All Products
      </a>
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="py-16 lg:py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-4">
        Why Choose Us
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        We're committed to providing the best shopping experience
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="text-center animate-on-scroll">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-primary-100 rounded-full mb-6">
          <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-3">Premium Quality</h3>
        <p class="text-gray-600">Every product is carefully selected and tested to meet our high standards.</p>
      </div>
      
      <div class="text-center animate-on-scroll">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-primary-100 rounded-full mb-6">
          <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-3">Fast Shipping</h3>
        <p class="text-gray-600">Get your orders delivered quickly with our expedited shipping options.</p>
      </div>
      
      <div class="text-center animate-on-scroll">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-primary-100 rounded-full mb-6">
          <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-3">Secure Shopping</h3>
        <p class="text-gray-600">Shop with confidence knowing your data is protected by industry-leading security.</p>
      </div>
    </div>
  </div>
</section>

<!-- Newsletter Section -->
<section class="py-16 lg:py-24 bg-gradient-primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-4">
      Stay in the Loop
    </h2>
    <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
      Be the first to know about new products, exclusive offers, and style tips
    </p>
    
    <form action="#" method="post" class="max-w-md mx-auto flex gap-4">
      <input type="email" placeholder="Enter your email" required
             class="flex-1 px-4 py-3 rounded-xl border-0 bg-white/10 backdrop-blur-sm text-white placeholder-white/70 focus:outline-none focus:ring-2 focus:ring-white/50">
      <button type="submit" class="btn-secondary bg-white text-primary-600 hover:bg-gray-100 px-6 py-3">
        Subscribe
      </button>
    </form>
  </div>
</section>
